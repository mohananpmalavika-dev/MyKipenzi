    "@fontsource/manrope": "^5.3.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^5.0.0",
    "cookie": "^1.0.2",
    "dotenv": "^17.0.0",
    "express": "^5.1.0",
    "file-type": "^21.0.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "lucide-react": "^0.468.0",
    "msedge-tts": "^2.0.9",
    "multer": "^2.0.0",
    "pg": "^8.16.0",
    "pino": "^10.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "vite": "^7.1.0"
