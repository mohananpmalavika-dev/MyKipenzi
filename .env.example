NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://kipenzi:local_password@localhost:5432/kipenzi
REDIS_URL=redis://localhost:6379
ALLOW_REGISTRATION=true
TRUST_PROXY=0
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kipenzi-private
S3_ACCESS_KEY=local_admin
S3_SECRET_KEY=local_storage_password
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
# Never disable scanning in production. Local-only escape hatch while signatures download:
SKIP_VIRUS_SCAN=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_VOICE_ID=
# D-ID key is the base64 credential provided by D-ID; do not add 'Basic '.
DID_API_KEY=
TURN_URL=turn:localhost:3478
TURN_SECRET=replace_with_random_shared_secret_at_least_32_characters
TURN_PUBLIC_IP=127.0.0.1
AI_DAILY_LIMIT=30
AI_GLOBAL_DAILY_LIMIT=1000
